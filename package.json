{
  "name": "nodejs-basic-ts-structure",
  "version": "1.0.0",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "concurrently \"tsc --watch\" \"nodemon ./bin/www\"",
    "watch": "tsc --watch",
    "start": "nodemon ./bin/www",
    "build": "npm run clean && npm run build-ts && npm run copy-views && npm run copy-config-json",
    "build-ts": "tsc",
    "clean": "rimraf ./dist",
    "copy-views": "copyfiles -u 1 ./src/**/*.ejs ./dist",
    "copy-config-json": "copyfiles -u 1 ./src/**/*.json ./dist",
    "upgrade": "npm update --save-dev && npm update --save",
    "outdated-versions": "npm outdated"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/compression": "^1.8.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "copyfiles": "^2.4.1",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "mysql2": "^3.22.5",
    "sequelize": "^6.37.8",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.3",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
